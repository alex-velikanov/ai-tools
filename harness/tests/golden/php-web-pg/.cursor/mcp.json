{
  "mcpServers": {
    "xdebug": {
      "command": "<DOCKER>",
      "args": [
        "compose",
        "-f",
        "<ROOT>/compose.yaml",
        "exec",
        "-T",
        "app",
        "xdebug-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
